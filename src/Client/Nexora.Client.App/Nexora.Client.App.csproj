<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Nexora.Client.App</RootNamespace>
    <AssemblyName>NexoraClient</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\..\..\assets\nexora-client.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nexora.Client.Core\Nexora.Client.Core.csproj" />
    <ProjectReference Include="..\..\UI\Nexora.UI\Nexora.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\assets\nexora-client.ico" Link="nexora-client.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\scripts\Install-NexoraQueue.ps1" Link="scripts\Install-NexoraQueue.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\scripts\Uninstall-NexoraQueue.ps1" Link="scripts\Uninstall-NexoraQueue.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
