<Window x:Class="Nexora.Client.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexora Printer LAN — Client" Width="1100" Height="720" MinWidth="900" MinHeight="560"
        Style="{StaticResource NexoraWindow}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <DockPanel Background="{StaticResource Brush.Sidebar}">
            <StackPanel DockPanel.Dock="Top" Margin="22,24,16,24">
                <TextBlock Text="Nexora" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Printer LAN · Client" Foreground="{StaticResource Brush.SidebarText}" FontSize="12"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Margin="22,0,0,16" Foreground="{StaticResource Brush.SidebarText}" FontSize="11">
                <Run Text="Version"/> <Run Text="{Binding Version, Mode=OneWay}"/>
            </TextBlock>
            <StackPanel>
                <RadioButton Style="{StaticResource NavItem}" Content="Dashboard" GroupName="nav" IsChecked="{Binding Page, Converter={StaticResource PageChecked}, ConverterParameter=dashboard}"/>
                <RadioButton Style="{StaticResource NavItem}" Content="Printers" GroupName="nav" IsChecked="{Binding Page, Converter={StaticResource PageChecked}, ConverterParameter=printers}"/>
                <RadioButton Style="{StaticResource NavItem}" Content="Devices" GroupName="nav" IsChecked="{Binding Page, Converter={StaticResource PageChecked}, ConverterParameter=devices}"/>
                <RadioButton Style="{StaticResource NavItem}" Content="Print jobs" GroupName="nav" IsChecked="{Binding Page, Converter={StaticResource PageChecked}, ConverterParameter=jobs}"/>
                <RadioButton Style="{StaticResource NavItem}" Content="Settings" GroupName="nav" IsChecked="{Binding Page, Converter={StaticResource PageChecked}, ConverterParameter=settings}"/>
            </StackPanel>
        </DockPanel>

        <!-- Content -->
        <Grid Grid.Column="1" Margin="28,24,14,14">

            <!-- DASHBOARD -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=dashboard}">
                <StackPanel>
                    <TextBlock Text="Dashboard" Style="{StaticResource H1}"/>
                    <TextBlock Text="Print from any application to “Nexora Printer LAN”; jobs are sent over your local network to the receiver PC." Style="{StaticResource Muted}" Margin="0,0,0,18"/>
                    <UniformGrid Columns="3">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Pending" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding Pending}" Style="{StaticResource Metric}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Delivered / printed" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding Completed}" Style="{StaticResource Metric}" Foreground="{StaticResource Brush.Ok}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Failed" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding Failed}" Style="{StaticResource Metric}" Foreground="{StaticResource Brush.Bad}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="This PC" Style="{StaticResource H2}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse Style="{StaticResource Dot}" Fill="{Binding QueueOk, Converter={StaticResource HealthBrush}}"/>
                                    <TextBlock><Run Text="Windows printer: " FontWeight="SemiBold"/><Run Text="{Binding QueueText, Mode=OneWay}"/></TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse Style="{StaticResource Dot}" Fill="{Binding CaptureOk, Converter={StaticResource HealthBrush}}"/>
                                    <TextBlock TextWrapping="Wrap"><Run Text="Job capture: " FontWeight="SemiBold"/><Run Text="{Binding CaptureText, Mode=OneWay}"/></TextBlock>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Muted}"><Run Text="Discovery: "/><Run Text="{Binding DiscoveryText, Mode=OneWay}"/></TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Receiver" Style="{StaticResource H2}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse Style="{StaticResource Dot}" Fill="{Binding ReceiverOk, Converter={StaticResource HealthBrush}}"/>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding ReceiverName}"/>
                                    <TextBlock Text="{Binding ReceiverAddress}" Style="{StaticResource Muted}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ReceiverText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap"><Run Text="Destination printer: " FontWeight="SemiBold"/><Run Text="{Binding DestinationPrinter, Mode=OneWay}"/></TextBlock>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Style="{StaticResource Primary}" Content="Send test page" Command="{Binding SendTestPage}"/>
                        <Button Content="Check connection" Command="{Binding CheckConnection}"/>
                        <Button Content="Discover receivers" Command="{Binding Discover}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- PRINTERS -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=printers}">
                <StackPanel>
                    <TextBlock Text="Printers" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,18"
                               Text="The Nexora queue uses Windows' own “Microsoft Print To PDF” driver and a local port that delivers each job to this app. No third-party driver is installed."/>
                    <Border Style="{StaticResource Card}" HorizontalAlignment="Left" MinWidth="560">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource Dot}" Fill="{Binding QueueOk, Converter={StaticResource HealthBrush}}"/>
                                <TextBlock Text="{Binding QueueName}" Style="{StaticResource H2}" Margin="0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding QueueText}" Margin="18,6,0,10"/>
                            <Grid Margin="18,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="Driver" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding QueueDriver}"/>
                                <TextBlock Grid.Row="1" Text="Port" Style="{StaticResource Muted}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding QueuePort}"/>
                                <TextBlock Grid.Row="2" Text="Default" Style="{StaticResource Muted}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding QueueIsDefault}"/>
                                <TextBlock Grid.Row="3" Text="Sends to" Style="{StaticResource Muted}"/><TextBlock Grid.Row="3" Grid.Column="1"><Run Text="{Binding ReceiverName, Mode=OneWay}"/> <Run Text="{Binding ReceiverAddress, Mode=OneWay}" Foreground="{StaticResource Brush.Muted}"/></TextBlock>
                            </Grid>
                            <WrapPanel>
                                <Button Style="{StaticResource Primary}" Content="Add printer…" Command="{Binding InstallQueue}" Visibility="{Binding QueueInstalled, Converter={StaticResource InvBoolVis}}"/>
                                <Button Content="Repair printer…" Command="{Binding InstallQueue}" Visibility="{Binding QueueInstalled, Converter={StaticResource BoolVis}}"/>
                                <Button Content="Set as default" Command="{Binding SetDefaultPrinter}"/>
                                <Button Content="Windows printer settings" Command="{Binding OpenPrinterSettings}"/>
                                <Button Style="{StaticResource Danger}" Content="Remove printer…" Command="{Binding RemoveQueue}" Visibility="{Binding QueueInstalled, Converter={StaticResource BoolVis}}"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" Text="Adding or removing the printer needs administrator approval (Windows shows a UAC prompt)."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- DEVICES -->
            <DockPanel Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=devices}">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Devices" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"><Run Text="Nexora receivers on your local network. "/><Run Text="{Binding DiscoveryText, Mode=OneWay}"/></TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Style="{StaticResource Primary}" Content="Discover" Command="{Binding Discover}"/>
                        <Button Content="Use selected receiver" Command="{Binding UseSelectedDevice}"/>
                        <Button Content="Check connection" Command="{Binding CheckConnection}"/>
                    </StackPanel>
                </StackPanel>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Margin="0,0,14,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Receiver" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="IP address" Binding="{Binding Address}" Width="150"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="170"/>
                            <DataGridTextColumn Header="Destination printer" Binding="{Binding Printer}" Width="*"/>
                            <DataGridTextColumn Header="Pairing" Binding="{Binding Paired}" Width="100"/>
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="Printers installed on the connected receiver" Style="{StaticResource H2}" Margin="0,18,0,8"/>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding ReceiverPrinters}" Margin="0,0,14,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Printer" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Driver" Binding="{Binding DriverName}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Ready" Binding="{Binding IsReady}" Width="60"/>
                            <DataGridTextColumn Header="Windows status" Binding="{Binding StatusText}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Virtual" Binding="{Binding IsVirtual}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </DockPanel>

            <!-- JOBS -->
            <DockPanel Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=jobs}">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Print jobs" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Muted}" Text="“Validated” means the receiver stored the document and verified its checksum. “Completed” means the receiver's Windows spooler finished sending it to the printer."/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Jobs}" x:Name="JobsGrid" Margin="0,0,14,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Document" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="Submitted" Binding="{Binding Submitted}" Width="120"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="110"/>
                        <DataGridTemplateColumn Header="Status" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource Dot}" Fill="{Binding State, Converter={StaticResource StateBrush}}"/>
                                        <TextBlock Text="{Binding State}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="1.3*"/>
                        <DataGridTemplateColumn Header="Details" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding Details}" ToolTip="{Binding Details}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="210">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Open" Padding="8,2" Command="{Binding DataContext.OpenJobFile, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                        <Button Content="Retry" Padding="8,2" IsEnabled="{Binding CanRetry}" Command="{Binding DataContext.Retry, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                        <Button Content="Cancel" Padding="8,2" IsEnabled="{Binding CanCancel}" Command="{Binding DataContext.Cancel, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- SETTINGS -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=settings}">
                <StackPanel>
                    <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,0,0,16"/>
                    <WrapPanel>
                        <Border Style="{StaticResource Card}" Width="400" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Security — pairing" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="Enter the 20-character pairing code shown on the receiver PC. It authenticates both PCs and encrypts every job. It is stored encrypted with Windows DPAPI."/>
                                <TextBlock Text="Pairing code" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding PairingInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" CharacterCasing="Upper"/>
                                <TextBlock Text="{Binding PairingStatus}" Style="{StaticResource Muted}" Margin="0,6,0,10"/>
                                <Button Style="{StaticResource Primary}" Content="Save pairing code" HorizontalAlignment="Left" Command="{Binding SavePairing}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Width="400" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Network" Style="{StaticResource H2}"/>
                                <CheckBox Content="Find receivers automatically (UDP broadcast)" IsChecked="{Binding AutoDiscovery}"/>
                                <TextBlock Text="Manual receiver address (optional, e.g. 192.168.0.31 or HarshalOza-PC:9102)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ManualAddress}"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Discovery port (UDP)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding DiscoveryPort}" MinWidth="0"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Job port (TCP)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding TransportPort}" MinWidth="0"/></StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Width="400" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="General" Style="{StaticResource H2}"/>
                                <CheckBox Content="Start with Windows (required to capture jobs after sign-in)" IsChecked="{Binding StartWithWindows}"/>
                                <CheckBox Content="Show notifications for delivered / failed jobs" IsChecked="{Binding Notifications}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Keep job history (days)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding RetentionDays}" MinWidth="0"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Max job size (MB)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding MaxJobMb}" MinWidth="0"/></StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"><Run Text="Computer name: "/><Run Text="{Binding ClientName, Mode=OneWay}"/></TextBlock>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Primary}" Content="Save settings" Command="{Binding SaveSettings}"/>
                        <Button Content="Open log folder" Command="{Binding OpenLogs}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
