<Window x:Class="Nexora.App.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexora Printer LAN" Width="1140" Height="740" MinWidth="900" MinHeight="560"
        Style="{StaticResource NexoraWindow}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Background="{StaticResource Brush.Sidebar}">
            <StackPanel DockPanel.Dock="Top" Margin="22,24,16,24">
                <TextBlock Text="Nexora" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Printer LAN" Foreground="{StaticResource Brush.SidebarText}" FontSize="12"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Margin="22,0,0,16" Foreground="{StaticResource Brush.SidebarText}" FontSize="11">
                <Run Text="Version"/> <Run Text="{Binding Version, Mode=OneWay}"/>
            </TextBlock>
            <StackPanel>
                <RadioButton Style="{StaticResource NavItem}" Content="Dashboard" GroupName="nav" IsChecked="{Binding Page, Converter={StaticResource PageChecked}, ConverterParameter=dashboard}"/>
                <StackPanel Visibility="{Binding HasClient, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="PRINT TO ANOTHER PC" Foreground="#7F8FA8" FontSize="10" Margin="28,14,0,4"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="Print jobs" GroupName="nav" IsChecked="{Binding Page, Converter={StaticResource PageChecked}, ConverterParameter=jobs}"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="Devices" GroupName="nav" IsChecked="{Binding Page, Converter={StaticResource PageChecked}, ConverterParameter=devices}"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="Nexora printer" GroupName="nav" IsChecked="{Binding Page, Converter={StaticResource PageChecked}, ConverterParameter=printer}"/>
                </StackPanel>
                <StackPanel Visibility="{Binding HasReceiver, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="RECEIVE ON THIS PC" Foreground="#7F8FA8" FontSize="10" Margin="28,14,0,4"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="Received jobs" GroupName="nav" IsChecked="{Binding Page, Converter={StaticResource PageChecked}, ConverterParameter=received}"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="Printers on this PC" GroupName="nav" IsChecked="{Binding Page, Converter={StaticResource PageChecked}, ConverterParameter=rx-printers}"/>
                </StackPanel>
                <RadioButton Style="{StaticResource NavItem}" Content="Settings" GroupName="nav" Margin="0,14,0,0" IsChecked="{Binding Page, Converter={StaticResource PageChecked}, ConverterParameter=settings}"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Column="1" Margin="28,24,14,14">
            <!-- Dashboard: one section per installed role -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=dashboard}">
                <StackPanel>
                    <TextBlock Text="Dashboard" Style="{StaticResource H1}"/>
                    <TextBlock Text="{Binding RoleText}" Style="{StaticResource Muted}" Margin="0,0,0,18"/>
                    <ContentControl Content="{Binding Client}" ContentTemplate="{StaticResource ClientDashboard}" Visibility="{Binding HasClient, Converter={StaticResource BoolVis}}"/>
                    <ContentControl Content="{Binding Receiver}" ContentTemplate="{StaticResource ReceiverDashboard}" Visibility="{Binding HasReceiver, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
            </ScrollViewer>

            <ContentControl Content="{Binding Client}" ContentTemplate="{StaticResource ClientJobs}" Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=jobs}"/>
            <ContentControl Content="{Binding Client}" ContentTemplate="{StaticResource ClientDevices}" Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=devices}"/>
            <ContentControl Content="{Binding Client}" ContentTemplate="{StaticResource ClientPrinter}" Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=printer}"/>
            <ContentControl Content="{Binding Receiver}" ContentTemplate="{StaticResource ReceiverJobs}" Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=received}"/>
            <ContentControl Content="{Binding Receiver}" ContentTemplate="{StaticResource ReceiverPrinters}" Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=rx-printers}"/>

            <!-- Settings: app-wide, then one section per role -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=settings}">
                <StackPanel>
                    <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,0,0,16"/>
                    <Border Style="{StaticResource Card}" HorizontalAlignment="Left" Width="814">
                        <StackPanel>
                            <TextBlock Text="General" Style="{StaticResource H2}"/>
                            <TextBlock TextWrapping="Wrap"><Run Text="Roles on this PC: " FontWeight="SemiBold"/><Run Text="{Binding RoleText, Mode=OneWay}"/></TextBlock>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,8" Text="To add or remove a role, run Setup again (Apps &amp; features → Nexora Printer LAN → Modify)."/>
                            <CheckBox Content="Start Nexora Printer LAN when I sign in (needed so printed jobs are sent and received)" IsChecked="{Binding StartWithWindows}" IsEnabled="{Binding AutostartMachineWide, Converter={StaticResource InvBool}}"/>
                            <TextBlock Style="{StaticResource Muted}" Visibility="{Binding AutostartMachineWide, Converter={StaticResource BoolVis}}" Text="Enabled for all users by Setup."/>
                            <Button Content="Save" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding SaveGeneral}"/>
                        </StackPanel>
                    </Border>
                    <ContentControl Content="{Binding Client}" ContentTemplate="{StaticResource ClientSettings}" Visibility="{Binding HasClient, Converter={StaticResource BoolVis}}"/>
                    <ContentControl Content="{Binding Receiver}" ContentTemplate="{StaticResource ReceiverSettings}" Visibility="{Binding HasReceiver, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
