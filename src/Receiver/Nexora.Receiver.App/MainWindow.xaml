<Window x:Class="Nexora.Receiver.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexora Printer LAN — Receiver" Width="1120" Height="720" MinWidth="900" MinHeight="560"
        Style="{StaticResource NexoraWindow}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Background="{StaticResource Brush.Sidebar}">
            <StackPanel DockPanel.Dock="Top" Margin="22,24,16,24">
                <TextBlock Text="Nexora" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Printer LAN · Receiver" Foreground="{StaticResource Brush.SidebarText}" FontSize="12"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Margin="22,0,0,16" Foreground="{StaticResource Brush.SidebarText}" FontSize="11">
                <Run Text="Version"/> <Run Text="{Binding Version, Mode=OneWay}"/>
            </TextBlock>
            <StackPanel>
                <RadioButton Style="{StaticResource NavItem}" Content="Dashboard" GroupName="nav" IsChecked="{Binding Page, Converter={StaticResource PageChecked}, ConverterParameter=dashboard}"/>
                <RadioButton Style="{StaticResource NavItem}" Content="Received jobs" GroupName="nav" IsChecked="{Binding Page, Converter={StaticResource PageChecked}, ConverterParameter=jobs}"/>
                <RadioButton Style="{StaticResource NavItem}" Content="Printers" GroupName="nav" IsChecked="{Binding Page, Converter={StaticResource PageChecked}, ConverterParameter=printers}"/>
                <RadioButton Style="{StaticResource NavItem}" Content="Settings" GroupName="nav" IsChecked="{Binding Page, Converter={StaticResource PageChecked}, ConverterParameter=settings}"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Column="1" Margin="28,24,14,14">

            <!-- DASHBOARD -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=dashboard}">
                <StackPanel>
                    <TextBlock Text="Dashboard" Style="{StaticResource H1}"/>
                    <TextBlock Text="This PC receives print jobs from Nexora clients on the local network." Style="{StaticResource Muted}" Margin="0,0,0,18"/>
                    <UniformGrid Columns="4">
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Received" Style="{StaticResource Muted}"/><TextBlock Text="{Binding ReceivedCount}" Style="{StaticResource Metric}"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Printing / queued" Style="{StaticResource Muted}"/><TextBlock Text="{Binding PrintingCount}" Style="{StaticResource Metric}" Foreground="{StaticResource Brush.Warn}"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Failed" Style="{StaticResource Muted}"/><TextBlock Text="{Binding FailedCount}" Style="{StaticResource Metric}" Foreground="{StaticResource Brush.Bad}"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Active connections" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Connections}" Style="{StaticResource Metric}"/></StackPanel></Border>
                    </UniformGrid>
                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Receiver" Style="{StaticResource H2}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse Style="{StaticResource Dot}" Fill="{Binding Running, Converter={StaticResource HealthBrush}}"/>
                                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ListenText}" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding ModeText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <Button Content="{Binding ToggleText}" Command="{Binding ToggleRunning}" Margin="0,0,8,6"/>
                                    <Button Content="Open received documents" Command="{Binding OpenFolder}" Margin="0,0,8,6"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Destination printer" Style="{StaticResource H2}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Ellipse Style="{StaticResource Dot}" Fill="{Binding PrinterReady, Converter={StaticResource HealthBrush}}"/>
                                    <TextBlock Text="{Binding DestinationText}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <WrapPanel>
                                    <Button Content="Test mode ON" CommandParameter="on" Command="{Binding SetTestMode}" Margin="0,0,8,6"/>
                                    <Button Content="Test mode OFF (print)" CommandParameter="off" Command="{Binding SetTestMode}" Margin="0,0,8,6"/>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Muted}" Text="Status comes from Windows. A disconnected USB printer is shown offline; jobs sent to it wait in the Windows queue."/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Pairing code" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource Muted}" Text="Enter this code in Nexora Client → Settings on each PC that should print here. It is never sent over the network." Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Pairing}" FontFamily="Consolas" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <Button Content="Show / hide" Command="{Binding ShowPairing}"/>
                                <Button Content="Copy" Command="{Binding CopyPairing}"/>
                                <Button Style="{StaticResource Danger}" Content="Generate new code…" Command="{Binding Regenerate}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Fingerprint}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- JOBS -->
            <DockPanel Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=jobs}">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Received jobs" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Muted}"><Run Text="Documents are stored in "/><Run Text="{Binding ReceivedFolder, Mode=OneWay}"/></TextBlock>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Jobs}" Margin="0,0,14,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Document" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="From" Binding="{Binding Client}" Width="*"/>
                        <DataGridTextColumn Header="Received" Binding="{Binding Received}" Width="115"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="100"/>
                        <DataGridTemplateColumn Header="Status" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource Dot}" Fill="{Binding State, Converter={StaticResource StateBrush}}"/>
                                        <TextBlock Text="{Binding State}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Printer" Binding="{Binding Printer}" Width="*"/>
                        <DataGridTemplateColumn Header="Details" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding Details}" ToolTip="{Binding Details}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="250">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Open" Padding="8,2" Command="{Binding DataContext.OpenJob, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                        <Button Content="Folder" Padding="8,2" Command="{Binding DataContext.RevealJob, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                        <Button Content="Print" Padding="8,2" Command="{Binding DataContext.Reprint, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                        <Button Content="Cancel" Padding="8,2" IsEnabled="{Binding CanCancel}" Command="{Binding DataContext.CancelJob, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- PRINTERS -->
            <DockPanel Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=printers}">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Printers" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Printers installed on this PC. Nexora prints through each printer's own Windows driver (for the Canon LBP2900 that is Canon's CAPT driver), so install and test the printer in Windows first."/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Primary}" Content="Use as destination" Command="{Binding UseAsDestination}"/>
                        <Button Content="Print test page" Command="{Binding PrintTestPage}"/>
                        <Button Content="Refresh" Command="{Binding RefreshPrinters}"/>
                    </StackPanel>
                    <TextBlock Margin="0,12,0,0"><Run Text="Current destination: " FontWeight="SemiBold"/><Run Text="{Binding DestinationText, Mode=OneWay}"/></TextBlock>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}" Margin="0,0,14,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Printer" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Driver" Binding="{Binding DriverName}" Width="*"/>
                        <DataGridTextColumn Header="Port" Binding="{Binding PortName}" Width="120"/>
                        <DataGridCheckBoxColumn Header="Ready" Binding="{Binding IsReady}" Width="60"/>
                        <DataGridTextColumn Header="Windows status" Binding="{Binding StatusText}" Width="*"/>
                        <DataGridCheckBoxColumn Header="Virtual" Binding="{Binding IsVirtual}" Width="60"/>
                        <DataGridCheckBoxColumn Header="Default" Binding="{Binding IsDefault}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- SETTINGS -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=settings}">
                <StackPanel>
                    <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,0,0,16"/>
                    <WrapPanel>
                        <Border Style="{StaticResource Card}" Width="400" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Network" Style="{StaticResource H2}"/>
                                <TextBlock Text="Receiver name (shown to clients)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ReceiverName}"/>
                                <CheckBox Content="Answer discovery requests (UDP)" IsChecked="{Binding DiscoveryEnabled}" Margin="0,10,0,0"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Job port (TCP)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding TcpPort}" MinWidth="0"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Discovery port (UDP)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding UdpPort}" MinWidth="0"/></StackPanel>
                                </Grid>
                                <TextBlock Text="Listen address (0.0.0.0 = all network adapters)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding BindAddress}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Width="400" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Security" Style="{StaticResource H2}"/>
                                <TextBlock Text="Allowed clients (CIDR list, e.g. 192.168.0.0/24 or 192.168.0.140). Empty = this PC's own LAN subnet. Internet addresses are always refused." Style="{StaticResource Muted}"/>
                                <TextBox Text="{Binding AllowedNetworks}" Margin="0,6,0,0"/>
                                <TextBlock Text="Maximum job size (MB)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding MaxJobMb}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Width="400" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Printing and storage" Style="{StaticResource H2}"/>
                                <CheckBox Content="Print at actual size (default: shrink to printable area)" IsChecked="{Binding ActualSize}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Max render DPI" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding MaxDpi}" MinWidth="0"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Keep jobs (days)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding RetentionDays}" MinWidth="0"/></StackPanel>
                                </Grid>
                                <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Primary}" Content="Save settings" Command="{Binding SaveSettings}"/>
                        <Button Content="Open log folder" Command="{Binding OpenLogs}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
