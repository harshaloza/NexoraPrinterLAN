<Project>
  <!-- Shared build settings for every Nexora project. Change NexoraTfm in one place to retarget
       (e.g. net10.0-windows10.0.19041.0 once the .NET 10 SDK is installed). -->
  <PropertyGroup>
    <NexoraTfm>net8.0-windows10.0.19041.0</NexoraTfm>
    <TargetFramework>$(NexoraTfm)</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.2.2</Version>
    <Company>Nexora</Company>
    <Product>Nexora Printer LAN</Product>
    <Copyright>Copyright (c) 2026 Nexora</Copyright>
    <Deterministic>true</Deterministic>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
